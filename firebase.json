{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      ".git",
      ".git/**",
      ".firebase",
      ".firebase/**",
      ".agents",
      ".agents/**",
      ".codex",
      ".codex/**",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
